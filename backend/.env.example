# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT authentication
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# CORS — comma-separated frontend URLs allowed in production
# http://localhost:5173 is always permitted; list production URL(s) here.
# Example (Render): https://space-news-hub.vercel.app
FRONTEND_URL=https://space-news-hub.vercel.app
